# 数据库
DATABASE_URL=postgresql+asyncpg://itasset:your_password@localhost:5432/itasset

# 安全
AGENT_INITIAL_TOKEN=your-uuid-here
SECRET_KEY=change-me-in-production-random-32-chars

# 服务器对外地址（Agent 回连用）
SERVER_URL=http://your-server:8000
WS_ENDPOINT=ws://your-server:8000/ws/agent/

# 包存储
PACKAGES_DIR=/opt/itasset/packages
